<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Survey</title>
  <link rel="stylesheet" href="/styles/survey.css">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
    crossorigin="anonymous"
    >
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

</head>
<body>
  <%- include('partials/navbar') %>

  <div class="survey-container">
    <% if (section === "completed") { %>
      <% if (typeof coinsEarned !== 'undefined' && coinsEarned !== null) { %>
        <div class="reward-message">
          <h3>You earned <%= coinsEarned %> extra coins from your last survey!</h3>
        </div>
      <% } %>
      <h2>All surveys completed for today!</h2>

      <% if (advice) { %>
        <% if (advice.section == 'general') { %>
          <div class="advice-box">
            <p><strong>General Focus Area:</strong> <%= advice.question %></p>
            <p><%= advice.advice %></p>
          </div>
        <% } else if (advice.section == 'mental') { %>
          <div class="advice-box">
            <p><strong>Mental Focus Area:</strong> <%= advice.question %></p>
            <p><%= advice.advice %></p>
          </div>
        <% } else if (advice.section == 'physical') { %>
          <div class="advice-box">
            <p><strong>Physical Focus Area:</strong> <%= advice.question %></p>
            <p><%= advice.advice %></p>
          </div>
        <% } %>
      <% } else { %>
        <div class="advice-box">
          <p><strong>No advice available at this time.</strong></p>
        </div>
      <% } %>

      <% if (typeof calcTime !== 'undefined' && calcTime !== null) { %>
        <div class="insight-timing">
          Wellness insights calculated in <strong><%= calcTime %> ms</strong>
        </div>
      <% } %>

      <a href="/home" class="btn">Home</a>
      <a href="/games" class="btn">Game</a>
      <a href="/shop" class="btn">Shop</a>

    <% } else if (section === "choice") { %>
      <div class="container py-5">
        <!-- Header -->
        <div class="container mb-5">
            <h1 class="fw-semibold">Daily Check-In</h1>
            <p class="text-muted fs-5">Hello! Where would you like to start today?</p>
        </div>

        <!-- Cards -->
        <div class="row g-4 justify-content-center">
            <!-- General Component -->
            <div class="col-md-3">
                <a href="/survey/?section=general" class="text-decoration-none text-body">
                    <div class="card checkin-card h-100">
                        <div class="card-body">
                            <p class="fw-semibold">🪙 5 Coins</p>
                            <h3 class="mt-3">General</h3>
                            <p class="text-muted">How are your daily habits shaping up? Let's take a look at your hyrdation, nutrition, and overall outlook on life.</p>
                        </div>
                    </div>
                </a>
            </div>
            <!-- Mental Component -->
            <div class="col-md-3">
                <a href="/survey/?section=mental" class="text-decoration-none text-body">
                    <div class="card checkin-card h-100">
                        <div class="card-body">
                            <p class="fw-semibold">🪙 5 Coins</p>
                            <h3 class="mt-3">Mental</h3>
                            <p class="text-muted">What was going on in your mind today? Take a deep breath and let's journey into your mind.</p>
                        </div>
                    </div>
                </a>
            </div>
            <!-- Physical Component -->
            <div class="col-md-3">
                <a href="/survey/?section=physical" class="text-decoration-none text-body">
                    <div class="card checkin-card h-100">
                        <div class="card-body">
                            <p class="fw-semibold">🪙 5 Coins</p>
                            <h3 class="mt-3">Physical</h3>
                            <p class="text-muted">How did your body feel today? Let's take a moment to reflect on your current energy.</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
    <% } else if (section === "next") { %>
      <h2>Would you like to continue?</h2>
      <% if (!userProgress.mental) { %>
        <a href="/survey?section=mental" class="btn">Mental</a>
      <% } %>
      <% if (!userProgress.physical) { %>
        <a href="/survey?section=physical" class="btn">Physical</a>
      <% } %>
      <a href="/home" class="btn">Home</a>
      <a href="/games" class="btn">Game</a>
      <a href="/shop" class="btn">Shop</a>

    <%}%> <% if (section !== "choice" && section !== "completed" && typeof questions !== 'undefined') { %>
      <div class="container py-5" id="surveyFormContainer">
        <div class="coins-display">
          <p>
            <span id="coin-count"><%= coins ?? 0 %></span>
            <span id="coin-emoji" class="coin-emoji" aria-hidden="true">🪙</span>
          </p>
        </div>
        <div class="mb-3">
            <h3 class="fw-semibold"><%= section.charAt(0).toUpperCase() + section.slice(1) %> Check-In</h3>
                        <div class="small text-muted mt-2">
                <span id="progressText">Question 1 of <%= questions.length %></span>
            </div>
            <div class="progress" role="progressbar" aria-label="Progress">
                <div id="progressBar" class="progress-bar"></div>
            </div>

        </div>

        <form id="progressForm" method="POST" action="/submit-survey">
          <input type="hidden" name="section" value="<%= section %>">
          <input type="hidden" name="userId" value="<%= userId %>">
          <input type="hidden" id="clientCoinDelta" name="clientCoinDelta" value="0">
          
          <input type="hidden" name="surveyResults" id="surveyResults">

          <div class="border rounded-4 p-4" id="iconContainer">
            <% questions.forEach((q, index) => { %>
              <section class="step <%= index === 0 ? 'active' : '' %>" data-step="<%= index + 1 %>">
                <h2 class="h5 fw-semibold mb-3"><%= q.question %></h2>
                <div class="row g-3">
                  <% q.responses.forEach((response) => { %>
                    <div class="col text-center">
                      <label class="card circular-card">
                        <input type="radio" name="<%= q.id %>" value="<%= response.value %>" class="hidden-radio">
                        <div>
                          <i class="bi <%= response.icon %>"></i>
                          <div class="fs-12"><%= response.label %></div>
                        </div>
                      </label>
                    </div>
                  <% }) %>
                </div>
              </section>
            <% }) %>
          </div>

          <div class="d-flex justify-content-between mt-4">
            <button type="button" class="btn btn-outline-secondary" id="backButton">Back</button>
            <button type="button" class="btn btn-primary" id="nextButton">Next ></button>
          </div>
        </form>
      </div>
    <% } %>
  </div>
  <script>
    // Track first-time selections per question, increment on-page coin display and a hidden counter.
    document.addEventListener('DOMContentLoaded', () => {
        const coinSpan = document.getElementById('coin-count');
        const hiddenInput = document.getElementById('clientCoinDelta');
        const coinEmoji = document.getElementById('coin-emoji');

        function animateCoin() {
            if (!coinEmoji) return;
            coinEmoji.classList.remove('bounce');
            // Force a reflow to allow animation to restart
            setTimeout(() => {
                coinEmoji.classList.add('bounce');
            }, 10);
        }

        // animate on initial load
        setTimeout(() => animateCoin(), 100);

        // Create audio element for coin collection sound
        const coinSound = new Audio('/sounds/coin_collect.mp3');
        coinSound.volume = 0.35;
        coinSound.playbackRate = 2.5;

        // Form logic starting here:
        const totalSteps = document.querySelectorAll('.step').length;
        let currentStep = 1;
        const userResponses = {};
        const counted = new Set();
        
        const progressBar = document.getElementById('progressBar');
        const progressText = document.getElementById('progressText');
        const steps = document.querySelectorAll('.step');
        const backButton = document.getElementById('backButton');
        const nextButton = document.getElementById('nextButton');
        const form = document.getElementById('progressForm');

        function updateFormProgress(stepNumber) {
            // display current question
            steps.forEach((step) => {
                step.classList.remove('active');
            })
            document.querySelector(`.step[data-step="${stepNumber}"]`).classList.add('active');

            // update progress bar
            const progressCompleted = (stepNumber / totalSteps) * 100;
            if (progressBar) progressBar.style.width = `${progressCompleted}%`;
            
            // update question progress text 
            if (progressText) progressText.textContent = `Question ${stepNumber} of ${totalSteps}`;

            backButton.disabled = (stepNumber === 1);
            nextButton.textContent = (stepNumber === totalSteps) ? "Submit" : "Next >";
        }

        function getSelectedValue(stepNumber) {
            const currentStepEl = document.querySelector(`.step[data-step="${stepNumber}"]`);
            const checked = currentStepEl.querySelector(`input[type="radio"]:checked`);
            return checked ? checked.value : "";
        }

        document.querySelectorAll('input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                userResponses[e.target.name] = e.target.value;

                // If it's the first time they answer this specific question
                const qName = e.target.name;
                if (!counted.has(qName)) {
                    counted.add(qName);

                    // Update their on-page coin count display
                    let currentCoins = parseInt(coinSpan.textContent, 10) || 0;
                    let hiddenDelta = parseInt(hiddenInput.value, 10) || 0;
                    
                    coinSpan.textContent = currentCoins + 1;
                    hiddenInput.value = hiddenDelta + 1;

                    // Play their animation and sound
                    animateCoin();
                    coinSound.currentTime = 0;
                    coinSound.play().catch(() => { /* Silently fail if blocked */ });
                }
            });
        });

        backButton.addEventListener("click", () => {
            if (currentStep > 1) {
                currentStep--;
                updateFormProgress(currentStep);
            }
        });

        nextButton.addEventListener("click", () => {
            const selection = getSelectedValue(currentStep);
            if (!selection) {
                alert("Please pick an option before continuing.");
                return;
            }

            if (currentStep < totalSteps) {
                currentStep++;
                updateFormProgress(currentStep);
            } else {
                // Package your JSON results before submitting to their backend
                document.getElementById('surveyResults').value = JSON.stringify(userResponses);
                form.submit();
            }
        });

        // Initialize display
        updateFormProgress(currentStep);
    });
  </script>
</body>
</html>
