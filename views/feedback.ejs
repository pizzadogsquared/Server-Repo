<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monthly Progress</title>
  <link rel="stylesheet" href="/styles/home.css">
  <script src="https://cdn.plot.ly/plotly-3.0.1.min.js"></script>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/styles/navbar.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="home-container">
    <h1>Feedback and Advice</h1>

    <% if (adviceList.length > 0) { %>
      <% 
        const sections = ['general_survey', 'mental_survey', 'physical_survey']; 
        sections.forEach(function(section) {
      %>
        <div class="advice-box">
            <h2><%= section.replace('_survey', '').charAt(0).toUpperCase() + section.replace('_survey', '').slice(1).toLowerCase() %> Focus Area:</h2>

          <% 
            // Filter for advice related to the current section
            const sectionAdvice = adviceList.filter(advice => advice.section === section); 
            if (sectionAdvice.length > 0) { 
              sectionAdvice.forEach(function(advice) {
          %>
            <p><strong>Question:</strong> <%= advice.question %></p>
            <p class="feedback-text"><%= advice.advice %></p>
          <% }) 
            } else { 
          %>
            <p class="no-advice-message">No advice available for this section.</p>
          <% } %>
        </div>
      <% }) 
    } else { %>
      <p>No feedback available.</p>
    <% } %>
    

  </div>

    <div class="home-container">
    <h1>Resources</h1>
      <div class="resource-box">
        <h2>Partner Links</h2>
        <a href="https://nazunitedway.org/" target="_blank">United Way of Northern Arizona</a>
        <h3>United Way of Northern Arizona is a non-profit orginization. If you are able, dontations can be made 
          <a href="https://andar.nazunitedway.org/comm/SinglePageRegPledge.jsp?SA=305813&DA=no" target="_blank">
             at this link. 
          </a>
        </h3>

        <h3>Additional Resources</h3>
        <a href="https://www.azyp.org/help-hope-for-youth" target="_blank">Arizona Youth Partnership</a><br><br>
        <a href="https://www.azdhs.gov/prevention/womens-childrens-health/womens-health/adolescent-health/index.php" target="_blank">Arizona Department of Mental Health Services</a>


      </div>

    

  </div>
</body>
</html>
