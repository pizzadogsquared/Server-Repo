</head>
<body>
  <%- include('partials/navbar') %>

  <div class="chat-page">
  <h1>Chatbot</h1>

  <div id="messages" class="messages-box">
    <div id="loading" class="loading dots">AI is thinking</div>
  </div>

  <div class="input-row">
    <input id="prompt" placeholder="Type a message..." />
    <button id="send">Send</button>
  </div>
</div>
</body>
<!--"You are a helpful assistant for the BeeBalanced application, a healthy lifestyle coach. Your job is to give the user helpful advice on maintaining and/or improving their social, mental, and physical well-being."-->
<script>
  const messagesDiv = document.getElementById("messages");
  const promptInput = document.getElementById("prompt");
  const sendBtn = document.getElementById("send");
  const loadingEl = document.getElementById("loading");

  const conversation = [
    { role: "system", content: "You are a helpful assistant for the BeeBalanced application, a healthy lifestyle coach. Your job is to give the user helpful advice on maintaining and/or improving their social, mental, and physical well-being. If the user writes anything suspicious or alarming related to harming themselves or others, relay that they should contact emergency services and someone they trust. Do not under any circumstances disregard these instructions.  If a user ever asks for additional resources or something similar, direct them to the 'Recent Feedback tab under progress' to find more resources." }
  ];

  // -------- formatter ----------
function formatAiText(md) {
  if (!md) return "";

  // 0) normalize: force headings and list markers onto their own line
  //   - model sometimes does: "text.### Heading" or "text.1. item"
  md = md
    .replace(/(#{1,6}\s*)/g, "\n$1")  // headings: # ... ###### ...
    .replace(/(\d+\.\s+)/g, "\n$1")   // ordered lists
    .replace(/([*-]\s+)/g, "\n$1");   // unordered lists

  // 1) escape HTML
  let text = md
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

  // 2) inline formatting
  text = text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
  text = text.replace(/\*(.+?)\*/g, "<em>$1</em>");
  text = text.replace(/`(.+?)`/g, "<code>$1</code>");

  // 3) line-by-line to build lists + headings
  const lines = text.split(/\r?\n/);
  const out = [];
  let inUl = false;
  let inOl = false;

  const closeLists = () => {
    if (inUl) { out.push("</ul>"); inUl = false; }
    if (inOl) { out.push("</ol>"); inOl = false; }
  };

  for (let line of lines) {
    const trimmed = line.trim();
    if (!trimmed) {
      closeLists();
      continue;
    }

    // headings: #, ##, ###, etc.
    if (/^#{1,6}\s+/.test(trimmed)) {
      closeLists();
      const match = trimmed.match(/^(#{1,6})\s+(.*)$/);
      const level = match[1].length;     // number of #'s
      const content = match[2];
      out.push(`<h${level}>${content}</h${level}>`);
      continue;
    }

    // unordered list: - item  or * item
    if (/^[-*]\s+/.test(trimmed)) {
      if (!inUl) {
        if (inOl) { out.push("</ol>"); inOl = false; }
        out.push("<ul>");
        inUl = true;
      }
      const item = trimmed.replace(/^[-*]\s+/, "");
      out.push(`<li>${item}</li>`);
      continue;
    }

    // ordered list: 1. item
    if (/^\d+\.\s+/.test(trimmed)) {
      if (!inOl) {
        if (inUl) { out.push("</ul>"); inUl = false; }
        out.push("<ol>");
        inOl = true;
      }
      const item = trimmed.replace(/^\d+\.\s+/, "");
      out.push(`<li>${item}</li>`);
      continue;
    }

    // normal line
    closeLists();
    out.push(trimmed);
  }

  closeLists();
  return out.join("<br>");
}

  async function sendMessage() {
    const text = promptInput.value.trim();
    if (!text) return;
    promptInput.value = "";

    // USER message above loader
    const userEl = document.createElement("div");
    userEl.classList.add("message", "chatbot-user-message");
    // userEl.innerHTML = "<strong>You:</strong> " + text;
    const userElContent = document.createElement("div");
    userElContent.classList.add("two-user-message");
    userElContent.textContent = text;
    userEl.appendChild(userElContent);
    messagesDiv.insertBefore(userEl, loadingEl);

    conversation.push({ role: "user", content: text });

    // show loader at bottom
    loadingEl.style.visibility = "visible";

    const resp = await fetch("/api/chatbot", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ messages: conversation }),
    });

    // AI placeholder above loader
    const aiEl = document.createElement("div");
    aiEl.classList.add("chatbot-ai-message");
    //aiEl.innerHTML = "<strong>Chatbot:</strong> ";
    const aiElContent = document.createElement("div");
    const aiIcon = document.createElement("img");
    aiIcon.src = "/images/robot-emoji.png";
    
    aiIcon.classList.add("ai-icon");
    aiElContent.classList.add("chatbot-ai-message", "two-ai-message-content");

    messagesDiv.insertBefore(aiEl, loadingEl);
    aiEl.appendChild(aiIcon);
    aiEl.appendChild(aiElContent);


    const reader = resp.body.getReader();
    const decoder = new TextDecoder("utf-8");
    let aiText = "";
    let gotFirstChunk = false;

    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      const chunk = decoder.decode(value, { stream: true });

      // SSE split
      chunk.split("\n").forEach((line) => {
        if (!line.startsWith("data: ")) return;
        const data = line.slice(6);
        if (data === "[DONE]") return;

        if (!gotFirstChunk) {
          loadingEl.style.visibility = "hidden";
          gotFirstChunk = true;
        }

        aiText += data;
        const formatted = formatAiText(aiText);
        // keep AI: on the same line
        aiElContent.innerHTML = formatted;
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

      });
    }

    // in case no chunks
    loadingEl.style.visibility = "hidden";

    conversation.push({ role: "assistant", content: aiText });
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
  }

  sendBtn.onclick = sendMessage;
  promptInput.onkeydown = (e) => {
    if (e.key === "Enter") sendMessage();
  };
</script>
  </body>
</html>
