<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <link rel="stylesheet" href="/styles/home.css">
  <script src="https://cdn.plot.ly/plotly-3.0.1.min.js"></script>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="home-container">
    <h1>Welcome to Bee Balanced</h1>
    <p>Your daily well-being tracker.</p>

    <div class="streak-badge">
      Current Streak: <strong><%= streak %></strong> 🔥
    </div>

    <!-- Bee Garden Virtual Pet Window -->
<!--
    <div id="bee-garden-container">
      <div id="hive-scene">
        <canvas id="bee-animation-canvas"></canvas>
        <div id="flower-garden">
        </div>
      </div>
    </div>
    <a href="/shop" class="btn">Visit Shop</a>

    <script>
      window.plantedFlowers = <%- JSON.stringify(plantedFlowers) %>;
    </script>

    <script src="/js/beeAnimation.js"></script>
-->

  
    <div class="home-main-row">
      <!-- Virtual Pet -->
      <div id="pet-container">
        <h2>Your Wellness Buddy</h2>

        <div id="pet-wrapper">
          <img
            id="pet-sprite"
            src="/images/sprites/dog_neutral.png"
            alt="Virtual Pet"
          />

          <img
            id="thirsty-icon"
            src="/images/sprites/thirsty.png"
            alt="Thirsty"
            class="<%= petThirsty ? 'visible' : 'hidden' %>"
          />
        </div>

        <p id="pet-caption">
          <span id="pet-mood-text"></span>
        </p>
      </div>

      <!-- Chat with the pet -->
      <div id="pet-chat-container">
        <h2>Chat with Your Buddy</h2>

        <div id="pet-messages" class="pet-messages-box">
          <div id="pet-loading" class="pet-loading dots">
            Buddy is thinking
          </div>
        </div>

        <div class="pet-input-row">
          <input id="pet-prompt" placeholder="Say something to your buddy..." />
          <button id="pet-send">Send</button>
        </div>
      </div>
    </div>

    <div class="home-buttons">
      <a href="/survey?section=choice" class="btn">Take Today's Surveys</a>
    </div>
</div>
    </div>
  <footer class="home-footer">
    <p>If you have any questions, please contact <strong>Davis Yi</strong> at 
      <a href="mailto:davisdaehanyi@gmail.com">davisdaehanyi@gmail.com</a>.
    </p>
  </footer>
</body>
<script>
  const petMood = "<%= petMood %>";
  const petThirsty = <%= petThirsty ? "true" : "false" %>;

  const petImg = document.getElementById("pet-sprite");
  const petMoodText = document.getElementById("pet-mood-text");

  const spriteMap = {
    happy: "/images/sprites/dog_happy.png",
    neutral: "/images/sprites/dog_neutral.png",
    sad: "/images/sprites/dog_sad.png",
  };

  petImg.src = spriteMap[petMood] || spriteMap.neutral;

  if (petMood === "happy") {
    petMoodText.textContent = "Your pet is feeling really good today!";
  } else if (petMood === "sad") {
    petMoodText.textContent = "Your pet seems a bit down. Maybe some self-care would help.";
  } else {
    petMoodText.textContent = "Your pet is feeling okay. Keep up your habits!";
  }

  if (petThirsty) {
    petMoodText.textContent += " And they're a little thirsty; have you had enough water?";
  }
</script>

<script>
  const surveyContext = <%- JSON.stringify(surveyContext || {}) %>;

  function buildSurveySummary(ctx) {
    const parts = [];
    for (const section of Object.keys(ctx)) {
      const entries = ctx[section];
      if (!entries || !entries.length) continue;

      const niceName =
        section.charAt(0).toUpperCase() + section.slice(1);

      const lines = entries.map(
        (e) => `- ${e.text} (score: ${e.score}/10)`
      );

      parts.push(`${niceName}:\n` + lines.join("\n"));
    }
    return parts.join("\n\n");
  }

  const surveySummary = buildSurveySummary(surveyContext);
  const petMessagesDiv = document.getElementById("pet-messages");
  const petPromptInput = document.getElementById("pet-prompt");
  const petSendBtn = document.getElementById("pet-send");
  const petLoadingEl = document.getElementById("pet-loading");

  const petConversation = [
    {
      role: "system",
      content:
        "You are Bee Balanced's virtual pet dog named Buddy. Speak in a warm, encouraging tone, occasionally using dog-like expressions (e.g., 'woof', 'wag', 'tail wagging'). You are here to react to the user's wellbeing, listen to how they're doing, and gently encourage healthy habits related to hydration, sleep, exercise, and mental health. Keep responses short and friendly. Do not answer political or historical questions, remind users what you are meant to help them with.",
    },
  ];

  if (surveySummary && surveySummary.trim().length > 0) {
    petConversation.push({
      role: "system",
      content:
        "Here is the user's most recent survey information:\n\n" +
        surveySummary +
        "\n\nUse this information to tailor your responses. Speak naturally, as if you just have a sense of how they are doing.",
    });
  }

  function formatAiText(md) {
    if (!md) return "";

    md = md
      .replace(/(#{1,6}\s*)/g, "\n$1")
      .replace(/(\d+\.\s+)/g, "\n$1")
      .replace(/([*-]\s+)/g, "\n$1");

    let text = md
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");

    text = text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
    text = text.replace(/\*(.+?)\*/g, "<em>$1</em>");
    text = text.replace(/`(.+?)`/g, "<code>$1</code>");

    const lines = text.split(/\r?\n/);
    const out = [];
    let inUl = false;
    let inOl = false;

    const closeLists = () => {
      if (inUl) { out.push("</ul>"); inUl = false; }
      if (inOl) { out.push("</ol>"); inOl = false; }
    };

    for (let line of lines) {
      const trimmed = line.trim();
      if (!trimmed) {
        closeLists();
        continue;
      }

      if (/^#{1,6}\s+/.test(trimmed)) {
        closeLists();
        const match = trimmed.match(/^(#{1,6})\s+(.*)$/);
        const level = match[1].length;
        const content = match[2];
        out.push(`<h${level}>${content}</h${level}>`);
        continue;
      }

      if (/^[-*]\s+/.test(trimmed)) {
        if (!inUl) {
          if (inOl) { out.push("</ol>"); inOl = false; }
          out.push("<ul>");
          inUl = true;
        }
        const item = trimmed.replace(/^[-*]\s+/, "");
        out.push(`<li>${item}</li>`);
        continue;
      }

      if (/^\d+\.\s+/.test(trimmed)) {
        if (!inOl) {
          if (inUl) { out.push("</ul>"); inUl = false; }
          out.push("<ol>");
          inOl = true;
        }
        const item = trimmed.replace(/^\d+\.\s+/, "");
        out.push(`<li>${item}</li>`);
        continue;
      }

      closeLists();
      out.push(trimmed);
    }

    closeLists();
    return out.join("<br>");
  }

  async function sendPetMessage() {
    const text = petPromptInput.value.trim();
    if (!text) return;
    petPromptInput.value = "";

    const userEl = document.createElement("div");
    userEl.classList.add("message", "user-message")
    // userEl.innerHTML = "<strong>You:</strong> " + text;
    const userElContent = document.createElement("div");
    userElContent.classList.add("message-content");
    userElContent.textContent = text;
    userEl.appendChild(userElContent);
    petMessagesDiv.insertBefore(userEl, petLoadingEl);

    petConversation.push({ role: "user", content: text });

    petLoadingEl.style.visibility = "visible";

    const resp = await fetch("/api/chatbot", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ messages: petConversation }),
    });

    const aiEl = document.createElement("div");
    aiEl.classList.add("message", "ai-message");

    const aiElContent = document.createElement("div");
    aiElContent.classList.add("message", "ai-message-content");

    petMessagesDiv.insertBefore(aiEl, petLoadingEl);

    const reader = resp.body.getReader();
    const decoder = new TextDecoder("utf-8");
    let aiText = "";
    let gotFirstChunk = false;

    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      const chunk = decoder.decode(value, { stream: true });

      chunk.split("\n").forEach((line) => {
        if (!line.startsWith("data: ")) return;
        const data = line.slice(6);
        if (data === "[DONE]") return;

        if (!gotFirstChunk) {
          petLoadingEl.style.visibility = "hidden";
          gotFirstChunk = true;
        }

        aiText += data;
        const formatted = formatAiText(aiText);
        // aiEl.innerHTML = "<strong>Buddy:</strong> " + formatted;
        aiElContent.textContent = formatted;
        aiEl.appendChild(aiElContent);
      });
    }
    petLoadingEl.style.visibility = "hidden";
    petConversation.push({ role: "assistant", content: aiText });
    petMessagesDiv.scrollTop = petMessagesDiv.scrollHeight;
  }

  petSendBtn.onclick = sendPetMessage;
  petPromptInput.onkeydown = (e) => {
    if (e.key === "Enter") sendPetMessage();
  };
</script>
</html>
